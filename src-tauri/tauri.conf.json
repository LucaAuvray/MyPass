{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-css-system/refs/heads/main/schemas/tauri-v2.json",
  "productName": "MyPass",
  "identifier": "com.mypass.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyPass",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.pwnedpasswords.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NEU4RTg0N0YwQ0ExClJXU2hESCtFams1a0FKVDNVdjM1TzNCdjhPK2Zpa0FDZDN2cUJJa09BSmwvZWtTZ1pVakM2R3FCCg==",
      "endpoints": [
        "https://mypass-luca.tail7687c9.ts.net/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
